# Telegram: @BotFather dan olingan token
BOT_TOKEN=123456:ABC...
# Buyurtmalar keladigan admin chat/guruh ID (masalan -1001234567890)
ADMIN_CHAT_ID=
# Adminlar Telegram ID lari, vergul bilan
ADMIN_IDS=

# Gemini API kaliti: https://aistudio.google.com/apikey
# Muhim: mijozlar yuz rasmlari uchun PULLIK tarifni (billing yoqilgan) ishlating.
GEMINI_API_KEY=
# Matn va rasm tahlili modeli
GEMINI_MODEL=gemini-3.5-flash
# Makiyajli rasm modeli (Nano Banana)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# 0 bo'lsa, makiyajli rasm yaratilmaydi, faqat matnli reja yuboriladi
MAKEUP_IMAGES=1

# Bir foydalanuvchiga kuniga AI so'rovlar soni (xarajatni nazorat qilish)
DAILY_AI_LIMIT=15
# Har bir xariddan bonus foizi (Beauty Club)
BONUS_PERCENT=3
DB_PATH=beauty_bot.db
CATALOG_PATH=data/products.json

# Onlayn to'lov (ixtiyoriy): @BotFather -> /mybots -> Payments -> Click yoki Payme.
# Bo'sh bo'lsa, faqat kuryerga naqd/karta orqali to'lov.
PAYMENT_PROVIDER_TOKEN=
# Yetkazib berish narxi va qaysi summadan boshlab bepul (so'm)
DELIVERY_FEE=25000
FREE_DELIVERY_FROM=300000
# Dugonasini taklif qilganga bonus (dugona birinchi xaridini olganda)
REFERRAL_BONUS=20000
# Teri tahlilidan necha kun keyin "teringiz qanday?" eslatmasi (0 = o'chirilgan)
REMINDER_DAYS=14
# To'lanmagan onlayn buyurtma necha soatdan keyin bekor qilinadi
PAYMENT_TTL_HOURS=24
