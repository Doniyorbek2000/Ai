# Telegram: @BotFather dan olingan token
BOT_TOKEN=123456:ABC...
# Buyurtmalar keladigan admin chat/guruh ID (masalan -1001234567890)
ADMIN_CHAT_ID=
# Adminlar Telegram ID lari, vergul bilan
ADMIN_IDS=

# Claude API (teri tahlili, stilist, atir, maslahatlar)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Makiyajli rasm yaratish (ixtiyoriy). Bo'sh qolsa, bot rasm o'rniga
# matnli makiyaj rejasini beradi. Hozircha: openai
MAKEUP_IMAGE_PROVIDER=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Bir foydalanuvchiga kuniga AI so'rovlar soni (xarajatni nazorat qilish)
DAILY_AI_LIMIT=15
# Har bir xariddan bonus foizi (Beauty Club)
BONUS_PERCENT=3
DB_PATH=beauty_bot.db
CATALOG_PATH=data/products.json
